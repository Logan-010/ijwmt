cabal-version: 3.0
name:          ijwmt
version:       0.1.0.0
synopsis:      I just want my torrent - purely functional torrenting
description:
  I just want my torrent - purely functional minimalist bittorrent client in your terminal

homepage:      https://github.com/Logan-010/hyoh
license:       MIT
license-file:  LICENSE
author:        Logan Briesemeister
maintainer:    ""
category:      Network
build-type:    Simple

common warnings
  ghc-options: -Wall

executable hyoh
  import:           warnings
  main-is:          Main.hs
  other-modules:
    Data.BitTorrent
    Data.BitTorrent.Bencode
    Data.BitTorrent.Wire

  -- other-extensions:
  build-depends:
    , base               ^>=4.20.2.0
    , bytestring
    , containers
    , cryptohash-sha1
    , cryptohash-sha256
    , entropy
    , text

  hs-source-dirs:   app
  default-language: Haskell2010
