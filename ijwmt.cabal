cabal-version: 3.0
name:          ijwmt
version:       0.1.0.0
synopsis:      I just want my torrent - purely functional torrenting
description:
  I just want my torrent - purely functional minimalist bittorrent client in your terminal

homepage:      https://github.com/Logan-010/ijwmt
license:       MIT
license-file:  LICENSE
author:        Logan Briesemeister
maintainer:    ""
category:      Network
build-type:    Simple

common warnings
  ghc-options: -Wall
               -threaded

executable ijwmt
  import:           warnings
  main-is:          Main.hs

  -- other-extensions:
  other-modules:    System.Args
                    Network.PeerPool
                    Capabilities
  build-depends:
    , base        ^>=4.20.2.0
    , bytestring
    , ijwmt
    , async
    , network
    , containers
    , cryptohash-sha1
    , stm

  hs-source-dirs:   app
  default-language: Haskell2010

library
  import:           warnings
  exposed-modules:
    Data.BitTorrent
    Data.BitTorrent.Bencode
    Data.BitTorrent.Extension
    Data.BitTorrent.Magnet
    Data.BitTorrent.Wire
    Network.BitTorrent
    Network.BitTorrent.Socket
    Network.BitTorrent.Tracker
    Network.BitTorrent.Transport.MSE
    Network.BitTorrent.Transport.TCP
    Network.BitTorrent.Transport.UTP
    Network.BitTorrent.Util
    Network.BitTorrent.WebSeed
    Network.BitTorrent.Wire

  other-modules:
    Network.BitTorrent.Tracker.HTTP
    Network.BitTorrent.Tracker.Types
    Network.BitTorrent.Tracker.UDP
    Network.BitTorrent.Tracker.Util
    Network.BitTorrent.Transport.UTP.Packet

  build-depends:
    , base               ^>=4.20.2.0
    , base16-bytestring
    , base32
    , bytestring
    , containers
    , cryptohash-sha1
    , cryptohash-sha256
    , crypton
    , entropy
    , http-client
    , http-client-tls
    , http-types
    , network
    , stm
    , text
    , url

  hs-source-dirs:   lib
  default-language: Haskell2010

test-suite ijwmt-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test lib app
  other-modules:
    BencodeSpec
    Capabilities
    Data.BitTorrent
    Data.BitTorrent.Bencode
    Data.BitTorrent.Extension
    Data.BitTorrent.Magnet
    Data.BitTorrent.Wire
    ExtensionSpec
    MagnetSpec
    MSESpec
    PeerPoolSpec
    Network.PeerPool
    Network.BitTorrent
    Network.BitTorrent.Socket
    Network.BitTorrent.Tracker
    Network.BitTorrent.Tracker.HTTP
    Network.BitTorrent.Tracker.Types
    Network.BitTorrent.Tracker.UDP
    Network.BitTorrent.Tracker.Util
    Network.BitTorrent.Transport.MSE
    Network.BitTorrent.Transport.TCP
    Network.BitTorrent.Transport.UTP
    Network.BitTorrent.Transport.UTP.Packet
    Network.BitTorrent.Util
    Network.BitTorrent.Wire
    TestSupport
    TorrentSpec
    TrackerHTTPSpec
    TrackerUDPSpec
    UTPSpec
    WireSpec

  build-depends:
    , async
    , base               ^>=4.20.2.0
    , base16-bytestring
    , base32
    , bytestring
    , containers
    , cryptohash-sha1
    , cryptohash-sha256
    , crypton
    , entropy
    , http-client
    , http-client-tls
    , http-types
    , network
    , stm
    , text
    , url

  default-language: Haskell2010
