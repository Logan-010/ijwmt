cabal-version: 3.0
name:          ijwmt
version:       0.1.0.0
synopsis:      I just want my torrent - purely functional torrenting
description:
  I just want my torrent - purely functional minimalist bittorrent client in your terminal

homepage:      https://github.com/Logan-010/hyoh
license:       MIT
license-file:  LICENSE
author:        Logan Briesemeister
maintainer:    ""
category:      Network
build-type:    Simple

common warnings
  ghc-options: -Wall

executable ijwmt
  import:           warnings
  main-is:          Main.hs

  -- other-extensions:
  build-depends:
    , base               ^>=4.20.2.0
    , ijwmt

  hs-source-dirs:   app
  default-language: Haskell2010

library
  import:           warnings
  exposed-modules:
    Data.BitTorrent
    Data.BitTorrent.Bencode
    Data.BitTorrent.Magnet
    Data.BitTorrent.Wire

  -- other-extensions:
  build-depends:
    , base               ^>=4.20.2.0
    , base16-bytestring
    , base32
    , bytestring
    , containers
    , cryptohash-sha1
    , cryptohash-sha256
    , entropy
    , text
    , url

  hs-source-dirs:   lib
  default-language: Haskell2010

test-suite ijwmt-test
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:
    BencodeSpec
    MagnetSpec
    TestSupport
    TorrentSpec
    WireSpec

  build-depends:
    , base               ^>=4.20.2.0
    , ijwmt
    , bytestring
    , containers
    , cryptohash-sha1
    , cryptohash-sha256
    , url

  default-language: Haskell2010
